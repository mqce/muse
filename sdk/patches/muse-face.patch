-extern "C" size_t muse_hatch_turn_read(int16_t *pcm, size_t frames, int wait_ms)
-{
-    return xStreamBufferReceive(s_out, pcm, frames * sizeof(int16_t), pdMS_TO_TICKS(wait_ms)) / sizeof(int16_t);
-}
