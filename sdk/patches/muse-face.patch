-#if CONFIG_MUSE_MOTION_GESTURES
-#include "qmi8658_motion.h"
-
-static esp_err_t motion_enable(bool enable)
-{
-    return muse_qmi8658_enable(bsp_i2c_get_handle(), enable);
-}
-#endif
