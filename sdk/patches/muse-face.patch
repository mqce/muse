-static void post(cmd_type_t type, uint32_t gen)
-{
-    if (s_cmds) {
-        cmd_t cmd{ type, gen, nullptr };
-        xQueueSend(s_cmds, &cmd, pdMS_TO_TICKS(100));
-    }
