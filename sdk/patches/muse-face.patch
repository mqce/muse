-    if (s_settle > 0) {
-        s_settle--;
-        return;   /* Muse's own tail: not pre-roll, and not wake word input either */
-    }
-    muse_wakeword_on_audio(s_chunk, MUSE_AUDIO_CHUNK);   /* wake tap: copy and return */
