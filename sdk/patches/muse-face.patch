 }
 
+#if CONFIG_MUSE_VOICEVOX_TTS
+static void voicevox_fallback(msg_t &m)
+{
+    voicevox_tts_cancel();
+    s_vv_on = false;
+    s_turn.silent = true;
+    size_t shown = s_turn.texts ? CAPTION_LEN(s_turn.texts + s_turn.tts_msg * TEXT_MAX) : m.len;
+    m.pcm_frames = (uint32_t)(shown * MIC_RATE / TEXT_CHARS_PER_S);
+    ESP_LOGW(TAG, "voicevox unavailable, captions only");
+}
+
+static void decode_voicevox(void)
+{
+    if (s_turn.tts_msg < 0) {
+        return;
+    }
+    msg_t &m = s_turn.msgs[s_turn.tts_msg];
+    int16_t buf[256];
+    bool idle = false;
+    for (;;) {
+        size_t room = xStreamBufferSpacesAvailable(s_out) / sizeof(int16_t);
+        if (room > 256) {
+            room = 256;
+        }
+        if (!room) {
+            break;
+        }
+        size_t n = voicevox_tts_read(s_turn.gen, buf, room);
+        if (!n) {
+            idle = true;
+            break;
+        }
+        if (s_turn.gen == s_gen.load()) {
+            xStreamBufferSend(s_out, buf, n * sizeof(int16_t), 0);
+        }
+        s_turn.pcm_out += n;
+    }
+    int st = voicevox_tts_state(s_turn.gen);
+    bool any = s_turn.pcm_out > m.pcm_start;
+    bool timed_out = !any && now_us() - s_vv_since > (int64_t)CONFIG_MUSE_VOICEVOX_TIMEOUT_S * 1000000LL;
+    if ((st == VOICEVOX_FAILED || timed_out) && !any) {
+        voicevox_fallback(m);
+        return;
+    }
+    if (idle && (st == VOICEVOX_DONE || (st == VOICEVOX_FAILED && any))) {
+        m.pcm_end = s_turn.pcm_out;
+        m.pcm_frames = m.pcm_end - m.pcm_start;
+        if (!m.pcm_frames) {
+            voicevox_fallback(m);
+            return;
+        }
+        m.tts = TTS_FINISHED;
+        s_turn.tts_msg = -1;
+        s_vv_on = false;
+    }
+}
+#endif
+
 /* Decodes buffered MP3 while the reply buffer has room. */
 static void decode(void)
 {
+#if CONFIG_MUSE_VOICEVOX_TTS
+    if (s_vv_on) {
+        decode_voicevox();
+        return;
+    }
+#endif
     if (s_turn.tts_msg < 0) {
         return;
     }
