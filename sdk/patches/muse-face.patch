-    }
-#endif
-    /* Captions are lossy; the end of a turn, and whether the note got there, must get through. */
-    TickType_t wait = (type == MUSE_HATCH_EV_DONE || type == MUSE_HATCH_EV_ERROR || type == MUSE_HATCH_EV_SENT)
-                          ? pdMS_TO_TICKS(200)
-                          : 0;
