-#define SCRATCH (64 * 1024)                /* inbound frames reassemble up to this */
-#define NDJSON_LINE_MAX (16 * 1024)               /* one NDJSON line / the chat ack */
-#define SUB_LINE_MAX (256 * 1024)          /* an event line grows its buffer up to this */
