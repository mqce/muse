+/* ---- Connection ---- */
+
+struct conn_t {
+    esp_tls_t *tls;
+    PsaCryptoBackend *crypto;
+    ClientSession *session;
+    uint8_t *ws, *rx, *tf, *sr, *svc, *env;   /* PSRAM scratch */
+    int64_t next_id;
+    int64_t sub_id;
+    int64_t last_rx_us, last_ping_us, last_use_us;
+};
