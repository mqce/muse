-    ESP_LOGW(TAG, "not sending a note again: %s", refused ? "Muse refused it" : "it went up whole, unacknowledged");
-    const char *caption = refused ? "MUSE DIDN'T TAKE IT" : MAY_HAVE_IT;
-    if (quiet) {
-        muse_state_set_caption("%s", caption);
-    } else {
-        go_idle(caption);
